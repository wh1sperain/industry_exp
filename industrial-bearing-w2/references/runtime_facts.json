{
  "scope": "ordinary single-row deep-groove bearings, given capacities, single steady load",
  "relations": {
    "gear_forces": {
      "inputs": {
        "power": "power",
        "speed": "shaft_speed",
        "diameter": "diameter",
        "pressure_angle": "normal_pressure_angle",
        "helix_angle": "helix_angle"
      },
      "outputs": {
        "torque": "moment",
        "Ft": "force",
        "Fr": "radial_load",
        "Fa": "axial_load",
        "Fy": "force",
        "Fz": "force"
      },
      "formula": "T=P/(2*pi*n/60); Ft=2*T/d; Fr=Ft*tan(alpha_n)/cos(beta); Fa=abs(Ft*tan(beta)); Fy=-Fr; Fz=-Ft",
      "sources": [
        "bearing-shaft"
      ],
      "domain": "Single external helical gear, explicit analyzed shaft speed. x along shaft; external Fy=-Fr, Fz=-Ft.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "axial_force_couple": {
      "inputs": {
        "axial_load": "axial_load",
        "diameter": "diameter",
        "direction": "direction"
      },
      "outputs": {
        "My": "moment",
        "Mz": "moment"
      },
      "formula": "r cross F: My=0; Mz=sign*Fa*d/2",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "Contact offset is in y plane; record coordinate convention; unknown direction requires both signs.",
      "enums": {
        "direction": [
          "positive",
          "negative"
        ]
      },
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "shaft_reactions_two_supports": {
      "inputs": {
        "span": "span",
        "position": "position",
        "Fy": "force",
        "Fz": "force",
        "My": "moment",
        "Mz": "moment"
      },
      "outputs": {
        "RAy": "force",
        "RBy": "force",
        "RAz": "force",
        "RBz": "force",
        "FrA": "radial_load",
        "FrB": "radial_load"
      },
      "formula": "RBy=-(a*Fy+Mz)/L; RBz=(-a*Fz+My)/L; RA=-F-RB; Fr=hypot(Ry,Rz)",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "One applied transverse load, 0<=a<=L; all two-plane loads and free couples required.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "resolve_axial_loads": {
      "inputs": {
        "axial_load": "axial_load",
        "locating_end": "locating_end"
      },
      "outputs": {
        "FaA": "axial_load",
        "FaB": "axial_load"
      },
      "formula": "Locating end carries all external axial load; floating end carries zero",
      "sources": [
        "bearing-shaft"
      ],
      "domain": "Explicit locating/floating evidence. No induced-thrust formulas for other bearing types.",
      "enums": {
        "locating_end": [
          "A",
          "B"
        ]
      },
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "lookup_coefficients": {
      "inputs": {
        "axial_load": "axial_load",
        "static_capacity": "static_capacity",
        "table": "coefficient_table"
      },
      "outputs": {
        "e": "coefficient",
        "X": "coefficient",
        "Y": "coefficient",
        "index": "ratio",
        "interpolation": "report"
      },
      "formula": "x=Fa/C0; interpolate table with its exact index and registered endpoint policy",
      "sources": [
        "S1",
        "S3"
      ],
      "domain": "Ordinary single-row deep-groove ball; question table takes precedence. No f0 substitution or upper extrapolation.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "equivalent_dynamic_load": {
      "inputs": {
        "radial_load": "radial_load",
        "axial_load": "axial_load",
        "rotation_factor": "rotation_factor",
        "e": "coefficient",
        "X": "coefficient",
        "Y": "coefficient",
        "load_factor": "load_factor"
      },
      "outputs": {
        "P": "equivalent_dynamic_load",
        "branch": "label"
      },
      "formula": "P=fp*(V*Fr if Fa<=e*V*Fr else X*V*Fr+Y*Fa)",
      "sources": [
        "S1",
        "S2"
      ],
      "domain": "Load factor applied once; capacities are not applied loads.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "bearing_life_hours": {
      "inputs": {
        "dynamic_capacity": "dynamic_capacity",
        "equivalent_load": "equivalent_dynamic_load",
        "speed": "shaft_speed"
      },
      "outputs": {
        "L10h": "life_hours"
      },
      "formula": "L10h=1e6/(60*n)*(C/P)^3",
      "sources": [
        "S2",
        "bearing-shaft"
      ],
      "domain": "Ball bearings; C,P,n>0; 90 percent reliability.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "reliability_life": {
      "inputs": {
        "basic_life": "life_hours",
        "factor": "reliability_factor"
      },
      "outputs": {
        "LRh": "life_hours"
      },
      "formula": "LRh=a1*L10h",
      "sources": [
        "S5"
      ],
      "domain": "0<a1<=1, explicit source/table version; no unprovided aISO.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "equivalent_static_load": {
      "inputs": {
        "radial_load": "radial_load",
        "axial_load": "axial_load",
        "static_capacity": "static_capacity"
      },
      "outputs": {
        "P0": "equivalent_static_load",
        "s0": "safety_factor"
      },
      "formula": "P0=max(Fr,.6*Fr+.5*Fa); s0=C0/P0",
      "sources": [
        "S4",
        "S6"
      ],
      "domain": "Ordinary deep-groove ball; actual load; no invented acceptance threshold.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "required_dynamic_rating": {
      "inputs": {
        "target_hours": "target_hours",
        "equivalent_load": "equivalent_dynamic_load",
        "speed": "shaft_speed",
        "factor": "reliability_factor"
      },
      "outputs": {
        "C_required": "dynamic_capacity"
      },
      "formula": "Cmin=P*(H*60*n/(a1*1e6))^(1/3)",
      "sources": [
        "S2",
        "S5"
      ],
      "domain": "Capacity requirement only; no catalog selection.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "check_equilibrium": {
      "inputs": {
        "span": "span",
        "position": "position",
        "Fy": "force",
        "Fz": "force",
        "My": "moment",
        "Mz": "moment",
        "RAy": "force",
        "RBy": "force",
        "RAz": "force",
        "RBz": "force"
      },
      "outputs": {
        "residuals": "report"
      },
      "formula": "Check both forces and moments against the independently bound load inventory",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "A zero residual does not by itself prove input completeness.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "geometry_position": {
      "inputs": {
        "span": "span",
        "numeric_position": "position",
        "geometry": "geometry"
      },
      "outputs": {
        "position": "position"
      },
      "formula": "a=L/2 or explicit numeric position",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "Conditional interpretation of explicit midpoint wording, kept separate from numeric dimensions.",
      "enums": {
        "geometry": [
          "midpoint",
          "numeric"
        ]
      },
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "transverse_components": {
      "inputs": {
        "radial_load": "radial_load",
        "plane": "plane"
      },
      "outputs": {
        "Fy": "force",
        "Fz": "force",
        "My": "moment",
        "Mz": "moment"
      },
      "formula": "One centerline transverse load; choose coordinate plane; other transverse component and couples zero",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "Single pump/impeller transverse force acting on shaft centerline; no off-axis couple.",
      "enums": {
        "plane": [
          "y",
          "z"
        ]
      },
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "check_speed_limit": {
      "inputs": {
        "speed": "shaft_speed",
        "limit": "speed_limit"
      },
      "outputs": {
        "ratio": "ratio"
      },
      "formula": "speed / catalog_limit",
      "sources": [
        "bearing-shaft"
      ],
      "domain": "Limit must come from the original question or an approved catalog row; ratio alone is not a whole-task judgment.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    }
  },
