  "relation_signatures": {
    "gear_forces": {
      "inputs": {
        "power": "power",
        "speed": "shaft_speed",
        "diameter": "diameter",
        "pressure_angle": "normal_pressure_angle",
        "helix_angle": "helix_angle"
      },
      "outputs": {
        "torque": "moment",
        "Ft": "force",
        "Fr": "radial_load",
        "Fa": "axial_load",
        "Fy": "force",
        "Fz": "force"
      },
      "formula": "T=P/(2*pi*n/60); Ft=2*T/d; Fr=Ft*tan(alpha_n)/cos(beta); Fa=abs(Ft*tan(beta)); Fy=-Fr; Fz=-Ft",
      "sources": [
        "bearing-shaft"
      ],
      "domain": "Single external helical gear, explicit analyzed shaft speed. x along shaft; external Fy=-Fr, Fz=-Ft.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "axial_force_couple": {
      "inputs": {
        "axial_load": "axial_load",
        "diameter": "diameter",
        "direction": "direction"
      },
      "outputs": {
        "My": "moment",
        "Mz": "moment"
      },
      "formula": "r cross F: My=0; Mz=sign*Fa*d/2",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "Contact offset is in y plane; record coordinate convention; unknown direction requires both signs.",
      "enums": {
        "direction": [
          "positive",
          "negative"
        ]
      },
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "shaft_reactions_two_supports": {
      "inputs": {
        "span": "span",
        "position": "position",
        "Fy": "force",
        "Fz": "force",
        "My": "moment",
        "Mz": "moment"
      },
      "outputs": {
        "RAy": "force",
        "RBy": "force",
        "RAz": "force",
        "RBz": "force",
        "FrA": "radial_load",
        "FrB": "radial_load"
      },
      "formula": "RBy=-(a*Fy+Mz)/L; RBz=(-a*Fz+My)/L; RA=-F-RB; Fr=hypot(Ry,Rz)",
      "sources": [
        "support_equilibrium_derivation"
      ],
      "domain": "One applied transverse load, 0<=a<=L; all two-plane loads and free couples required.",
      "enums": {},
      "error_codes": [
        "E_TYPE",
        "E_UNIT",
        "E_SOURCE",
        "E_RANGE",
        "E_MISSING"
      ]
    },
    "resolve_axial_loads": {
