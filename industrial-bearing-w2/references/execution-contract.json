        "axial_load": "axial_load",
        "locating_end": "locating_end"
      },
      "outputs": {
        "FaA": "axial_load",
        "FaB": "axial_load"
      },
      "formula": "Locating end carries all external axial load; floating end carries zero",
      "sources": [
        "bearing-shaft"
      ],
      "domain": "Explicit locating/floating evidence. No induced-thrust formulas for other bearing types.",
      "enums": {
        "locating_end": [
